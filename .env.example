# Backend/API
API_TITLE=LogAnalytics API
API_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File source defaults
DEFAULT_LOG_PATH=./simulator/log_generator/simulated_system.log
LOG_JOB_NAME=simulated_system

# Loki
LOKI_URL=http://localhost:3100
# LOKI_USERNAME=
# LOKI_PASSWORD=
DEFAULT_LOKI_QUERY={job="simulated_system"}
DEFAULT_LOOKBACK_MINUTES=1440
DEFAULT_QUERY_LIMIT=1000

# Agent / LLM
# Set at least one of these to enable LLM-assisted fixes & analysis
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GOOGLE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
# Backend API settings
API_TITLE=LogAnalytics API
API_VERSION=0.1.0
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Loki defaults and query behavior
DEFAULT_LOKI_QUERY={job="simulated_system"}
# Lookback window in minutes when querying logs/metrics
DEFAULT_LOOKBACK_MINUTES=1440
# Max number of log entries to return
DEFAULT_QUERY_LIMIT=1000

# Local file parsing
# Default log file used when no upload is active
DEFAULT_LOG_PATH=simulated_system.log
# Label used for "job" when reading from file source
LOG_JOB_NAME=simulated_system

# Loki connection (only required if using Loki)
LOKI_URL=http://localhost:3100
# Optional basic auth for Loki
LOKI_USERNAME=
LOKI_PASSWORD=

# Agent / LLM configuration
# Choose models or leave defaults
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MODEL=gemini-1.5-flash
# Sampling temperature for LLMs
LLM_TEMPERATURE=0.2

# Provider API keys (set only the one(s) you use)
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
